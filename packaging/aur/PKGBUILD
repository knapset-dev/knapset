# Maintainer: knapset-dev <knapset-dev@users.noreply.github.com>
pkgname=knapset
pkgver=2.1.0
pkgrel=1
pkgdesc="Zero-dependency database preference, formula, and constraint optimizer (SQLite, CSV, JSON, TUI, Web, MCP)"
arch=('any')
url="https://github.com/knapset-dev/knapset"
license=('MIT')
depends=('python>=3.10')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/knapset-dev/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
  cp -a \
    app_paths.py enricher.py formula_engine.py main.py mcp_server.py \
    preset_loader.py solver_engine.py theme_config.py v2_cli.py \
    web_server.py configs docs marketplace sources tui web_assets \
    "${pkgdir}/usr/lib/${pkgname}/"

  find "${pkgdir}/usr/lib/${pkgname}" -type d -name '__pycache__' -exec rm -rf {} +
  python3 -m compileall -d "/usr/lib/${pkgname}" -q "${pkgdir}/usr/lib/${pkgname}"

  cat <<'EOF' > "${pkgdir}/usr/bin/knapset"
#!/usr/bin/env python3
import sys

sys.path.insert(0, "/usr/lib/knapset")
from main import main

if __name__ == "__main__":
    main()
EOF
  chmod 755 "${pkgdir}/usr/bin/knapset"
  ln -s knapset "${pkgdir}/usr/bin/ks"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
