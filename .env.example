# Hardware Market Intelligence — Optional AI Provider Configuration
# Copy this file to `.env` and fill in any provider key(s) you wish to use.
# Run `python3 main.py providers` to check readiness or `python3 main.py providers --test auto`.

# Default provider ('auto' automatically picks the first ready Cloud/Local/CLI provider)
# HMI_AI_PROVIDER=auto

# --- Cloud REST APIs (Pure stdlib HTTPS — zero SDKs needed) ---
# GEMINI_API_KEY=your_google_ai_studio_key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...

# --- Local / Self-Hosted LLM Servers (100% Free & Offline) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# HMI_API_BASE=http://127.0.0.1:1234/v1
# HMI_API_KEY=not-needed
